generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id            String        @id @default(cuid())

  // Public / human-readable order reference
  reference     String?       @unique

  // Internal legacy ID
  orderId       String        @unique

  email         String
  phone         String

  // Stored in pesewas
  amount        Int

  // Admin-managed fields
  deliveryFee   Int?
  adminNotes    String?

  paymentStatus PaymentStatus @default(PENDING)

  // ✅ SMS tracking flags
  smsSent           Boolean @default(false)
  deliverySmsSent   Boolean @default(false)
  completedSmsSent  Boolean @default(false)

  createdAt     DateTime      @default(now())

  @@index([orderId])
  @@index([reference])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  DELIVERING
  COMPLETED
}
