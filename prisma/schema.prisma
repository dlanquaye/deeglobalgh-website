generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////
// ORDER SYSTEM
//////////////////////////////////////

model Order {
  id               String        @id @default(cuid())
  orderId          String        @unique
  reference        String?       @unique
  email            String
  phone            String
  amount           Int
  paymentStatus    PaymentStatus @default(PENDING)
  smsSent          Boolean       @default(false)
  createdAt        DateTime      @default(now())
  adminNotes       String?
  deliveryFee      Int?
  completedSmsSent Boolean       @default(false)
  deliverySmsSent  Boolean       @default(false)

  orderItems OrderItem[]

  @@index([orderId])
  @@index([reference])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  DELIVERING
  COMPLETED
  CANCELLED

}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity   Int
  unitPrice  Float
  totalPrice Float

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

//////////////////////////////////////
// IMPORTATION SYSTEM
//////////////////////////////////////

enum ImportShipmentStatus {
  DRAFT
  PAID
  IN_TRANSIT
  ARRIVED_GH
  COMPLETED
}

enum ImportSourceApp {
  ALIBABA
  APP_1688
  TAOBAO
  WECHAT
  OTHER
}

enum ShippingMode {
  AIR
  SEA
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOMO
  ONLINE_CARD
  OTHER
}

enum ImportCostType {
  SUPPLIER
  INTERNATIONAL_SHIPPING
  CLEARING_FEES
  FREIGHT_FORWARDER_FEES
  LOCAL_TRANSPORT
  OTHER
}

model ImportShipment {
  id             String          @id @default(cuid())
  reference      String
  supplierName   String
  sourceApp      ImportSourceApp
  sourceAppOther String?

  freightForwarderName String
  shippingMode         ShippingMode

  supplierTrackingId    String?
  supplierTrackingNotes String?

  paymentFinalizedDate DateTime?
  currency             String
  exchangeRateSnapshot Decimal

  status ImportShipmentStatus @default(DRAFT)

  forwarderReceivedConfirmed Boolean   @default(false)
  forwarderReceivedDate      DateTime?
  forwarderReceivedNotes     String?

  supplierDeclaredCbm  Decimal?
  forwarderMeasuredCbm Decimal?
  agreedCbm            Decimal?
  cbmDiscrepancyFlag   Boolean   @default(false)
  cbmConfirmedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  costs ImportCost[]
}

model ImportCost {
  id         String         @id @default(cuid())
  shipmentId String
  shipment   ImportShipment @relation(fields: [shipmentId], references: [id])

  costType    ImportCostType
  description String?
  amountGhs   Decimal

  paymentMethod PaymentMethod
  paymentDate   DateTime?

  receiptUrl String?

  isPaid         Boolean   @default(false)
  cashApproved   Boolean   @default(false)
  cashApprovedAt DateTime?
  cashNotes      String?

  isLocked Boolean @default(false)

  createdAt DateTime @default(now())
}

//////////////////////////////////////
// PRODUCT SYSTEM
//////////////////////////////////////

model Product {
  id  String @id @default(cuid())
  sku String @unique

  name String
  slug String @unique

  retailPrice      Float
  wholesalePrice   Float?
  distributorPrice Float?

  stockQty          Int @default(0)
  lowStockThreshold Int @default(3)

  categorySlug String
  levelSlugs   String[]

  imageSrc         String
  imageAlt         String
  imageTitle       String?
  imageCaption     String?
  imageDescription String?

  focusKeyphrase    String?
  metaTitle         String?
  metaDescription   String?
  socialTitle       String?
  socialDescription String?
  shortSummary      String?
  fullDescription   String?
  brand             String?
  tags              String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
}

//////////////////////////////////////
// INVENTORY LEDGER SYSTEM
//////////////////////////////////////

enum InventoryMovementType {
  SALE
  ADMIN_ADJUSTMENT
  RESTOCK
  IMPORT_ALLOCATION
  RETURN
  DAMAGE
}

model InventoryMovement {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  type     InventoryMovementType
  quantity Int
  note     String?

  createdAt DateTime @default(now())

  @@index([productId])
}
