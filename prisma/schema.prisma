generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NEON_DATABASE_URL")
}


model Order {
  id                 String              @id @default(cuid())
  orderId            String              @unique
  reference          String?             @unique
  email              String
  phone              String
  amount             Int
  paymentStatus      PaymentStatus       @default(PENDING)
  smsSent            Boolean             @default(false)
  createdAt          DateTime            @default(now())
  adminNotes         String?
  deliveryFee        Int?
  completedSmsSent   Boolean             @default(false)
  deliverySmsSent    Boolean             @default(false)
  stockReduced       Boolean             @default(false)
  status             String              @default("PENDING")
  locationId         String?
  inventoryMovements InventoryMovement[]
  events             OrderEvent[]
  orderItems         OrderItem[]

  @@index([orderId])
  @@index([reference])
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model ImportShipment {
  id                         String               @id @default(cuid())
  reference                  String
  supplierName               String
  sourceApp                  ImportSourceApp
  sourceAppOther             String?
  freightForwarderName       String
  shippingMode               ShippingMode
  supplierTrackingId         String?
  supplierTrackingNotes      String?
  paymentFinalizedDate       DateTime?
  currency                   String
  exchangeRateSnapshot       Decimal
  status                     ImportShipmentStatus @default(DRAFT)
  forwarderReceivedConfirmed Boolean              @default(false)
  forwarderReceivedDate      DateTime?
  forwarderReceivedNotes     String?
  supplierDeclaredCbm        Decimal?
  forwarderMeasuredCbm       Decimal?
  agreedCbm                  Decimal?
  cbmDiscrepancyFlag         Boolean              @default(false)
  cbmConfirmedAt             DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  costs                      ImportCost[]
}

model ImportCost {
  id             String         @id @default(cuid())
  shipmentId     String
  costType       ImportCostType
  description    String?
  amountGhs      Decimal
  paymentMethod  PaymentMethod
  paymentDate    DateTime?
  receiptUrl     String?
  isPaid         Boolean        @default(false)
  cashApproved   Boolean        @default(false)
  cashApprovedAt DateTime?
  cashNotes      String?
  isLocked       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  shipment       ImportShipment @relation(fields: [shipmentId], references: [id])
}

model Product {
  id                 String              @id @default(cuid())
  sku                String              @unique
  name               String
  slug               String              @unique
  retailPrice        Float
  wholesalePrice     Float?
  distributorPrice   Float?
  stockQty           Int                 @default(0)
  lowStockThreshold  Int                 @default(3)
  categorySlug       String
  levelSlugs         String[]
  imageSrc           String
  imageAlt           String
  imageTitle         String?
  imageCaption       String?
  imageDescription   String?
  focusKeyphrase     String?
  metaTitle          String?
  metaDescription    String?
  socialTitle        String?
  socialDescription  String?
  shortSummary       String?
  fullDescription    String?
  brand              String?
  tags               String[]
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  author             String?
  costPrice          Float?
  publisher          String?
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
}

model InventoryMovement {
  id        String                @id @default(cuid())
  productId String
  type      InventoryMovementType
  quantity  Int
  note      String?
  createdAt DateTime              @default(now())
  orderId   String?
  order     Order?                @relation(fields: [orderId], references: [id])
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([orderId])
}

model Admin {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  pinHash   String
  role      AdminRole    @default(ADMIN)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  pin       String?
  events    OrderEvent[]
}

model OrderEvent {
  id          String         @id @default(cuid())
  orderId     String
  adminId     String
  eventType   OrderEventType
  description String
  createdAt   DateTime       @default(now())
  admin       Admin          @relation(fields: [adminId], references: [id])
  order       Order          @relation(fields: [orderId], references: [id])
}

model Staff {
  id          String    @id @default(cuid())
  staffNumber String    @unique
  name        String
  role        StaffRole
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  staff     Staff[]
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inventory {
  id           String       @id @default(cuid())
  productId    String
  locationType LocationType
  locationId   String
  quantity     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([productId, locationType, locationId])
}

model StockMovement {
  id               String        @id @default(cuid())
  productId        String
  type             MovementType
  quantity         Int
  fromLocationType LocationType?
  fromLocationId   String?
  toLocationType   LocationType?
  toLocationId     String?
  createdByStaffId String
  createdAt        DateTime      @default(now())
  status           String        @default("PENDING")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  DELIVERING
  COMPLETED
  CANCELLED
}

enum ImportShipmentStatus {
  DRAFT
  PAID
  IN_TRANSIT
  ARRIVED_GH
  COMPLETED
}

enum ImportSourceApp {
  ALIBABA
  APP_1688
  TAOBAO
  WECHAT
  OTHER
}

enum ShippingMode {
  AIR
  SEA
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOMO
  ONLINE_CARD
  OTHER
}

enum ImportCostType {
  SUPPLIER
  INTERNATIONAL_SHIPPING
  CLEARING_FEES
  FREIGHT_FORWARDER_FEES
  LOCAL_TRANSPORT
  OTHER
}

enum InventoryMovementType {
  SALE
  ADMIN_ADJUSTMENT
  RESTOCK
  IMPORT_ALLOCATION
  RETURN
  DAMAGE
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum OrderEventType {
  VIEWED
  NOTE_ADDED
  DELIVERY_FEE_UPDATED
  STATUS_CHANGED
  PAYMENT_CONFIRMED
}

enum StaffRole {
  SUPER_ADMIN
  MANAGER
  CASHIER
  SALES
  DELIVERY_RIDER
  WAREHOUSE_MANAGER
  CRM_AGENT
}

enum LocationType {
  WAREHOUSE
  BRANCH
}

enum MovementType {
  PURCHASE
  TRANSFER
  SALE
  ADJUSTMENT
  RETURN
}
