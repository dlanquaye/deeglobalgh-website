  region       EducationalRegion?
  district     EducationalDistrict?
  circuit      EducationalCircuit?
  school       EducationalSchool?
  academicYear EducationalAcademicYear?
  class        EducationalClass?

  // Approvals
  approvalBody EducationalApprovalBody?

  // Synchronisation
  source EducationalSource?

