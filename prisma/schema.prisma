  @@index([lastIndexedAt])
}

// ============================================================================
// EDUCATIONAL KNOWLEDGE PLATFORM (EKP)
// INSTITUTION MODELS
// ============================================================================

model EducationalCountry {
  id String @id @default(cuid())

  entityId String            @unique
  entity   EducationalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  iso2 String  @unique
  iso3 String? @unique

  regions EducationalRegion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([iso2])
}

model EducationalRegion {
  id String @id @default(cuid())

  entityId String            @unique
  entity   EducationalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  countryId String
  country   EducationalCountry @relation(fields: [countryId], references: [id])

  regionCode String?

  districts EducationalDistrict[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([countryId])
}

model EducationalDistrict {
  id String @id @default(cuid())

  entityId String            @unique
  entity   EducationalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  regionId String
  region   EducationalRegion @relation(fields: [regionId], references: [id])

  districtCode String?

  circuits EducationalCircuit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
}

model EducationalCircuit {
  id String @id @default(cuid())

  entityId String            @unique
  entity   EducationalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  districtId String
  district   EducationalDistrict @relation(fields: [districtId], references: [id])

  circuitCode String?

  schools EducationalSchool[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([districtId])
}

model EducationalSchool {
  id String @id @default(cuid())

  entityId String            @unique
  entity   EducationalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  circuitId String?
  circuit   EducationalCircuit? @relation(fields: [circuitId], references: [id])

  emisCode String? @unique

  schoolType String?
  ownership  String?

  address String?
  town    String?

  latitude  Float?
  longitude Float?

  website String?
  email   String?
  phone   String?

  isActive Boolean @default(true)

  // ==========================================================
  // BACK RELATIONS
  // ==========================================================

  classes EducationalClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([circuitId])
  @@index([emisCode])
}

model EducationalAcademicYear {
  id String @id @default(cuid())

  entityId String            @unique
  entity   EducationalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  startYear Int
  endYear   Int

  startDate DateTime?
  endDate   DateTime?

  isCurrent Boolean @default(false)

  classes EducationalClass[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([startYear, endYear])
  @@index([isCurrent])
}

model EducationalClass {
  id String @id @default(cuid())

  entityId String            @unique
  entity   EducationalEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  academicYearId String
  academicYear   EducationalAcademicYear @relation(fields: [academicYearId], references: [id])

  schoolId String?
  school   EducationalSchool? @relation(fields: [schoolId], references: [id])

  levelId String?
  level   EducationalLevel? @relation(fields: [levelId], references: [id])

  classCode String?
  className String?

  stream String?

  teacherName String?

  capacity Int?

  // ==========================================================
  // BACK RELATIONS
  // ==========================================================

  estimateRequests EstimateRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([academicYearId])
  @@index([schoolId])
  @@index([levelId])
}

