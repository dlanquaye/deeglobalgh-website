generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id            String        @id @default(cuid())

  // Public / human-readable order reference (e.g. DG-1700000000)
  reference     String?       @unique

  // Internal legacy ID (kept for safety & indexing)
  orderId       String        @unique

  email         String
  phone         String

  // Stored in pesewas (matches Paystack amounts)
  amount        Int

  // Admin-managed fields
  deliveryFee   Int?          // Stored in pesewas
  adminNotes    String?

  paymentStatus PaymentStatus @default(PENDING)
  smsSent       Boolean       @default(false)

  createdAt     DateTime      @default(now())

  @@index([orderId])
  @@index([reference])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  DELIVERING
  COMPLETED
}
