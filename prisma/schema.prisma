
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DATABASE_URL_UNPOOLED")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Order {
  id                 String              @id @default(cuid())
  orderId            String              @unique
  reference          String?             @unique
  email              String
  phone              String
  amount             Int
  paymentStatus      PaymentStatus       @default(PENDING)
  smsSent            Boolean             @default(false)
  createdAt          DateTime            @default(now())
  adminNotes         String?
  deliveryFee        Int?
  completedSmsSent   Boolean             @default(false)
  deliverySmsSent    Boolean             @default(false)
  stockReduced       Boolean             @default(false)
  status             String              @default("PENDING")
  locationId         String?
  customerName       String?
  paymentMethod      String?
  inventoryMovements InventoryMovement[]
  events             OrderEvent[]
  orderItems         OrderItem[]

  @@index([orderId])
  @@index([reference])

  returns ReturnRequest[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])

  returnItems ReturnItem[]
}

model ImportShipment {
  id                         String               @id @default(cuid())
  reference                  String
  supplierName               String
  sourceApp                  ImportSourceApp
  sourceAppOther             String?
  freightForwarderName       String
  shippingMode               ShippingMode
  supplierTrackingId         String?
  supplierTrackingNotes      String?
  paymentFinalizedDate       DateTime?
  currency                   String
  exchangeRateSnapshot       Decimal
  status                     ImportShipmentStatus @default(DRAFT)
  forwarderReceivedConfirmed Boolean              @default(false)
  forwarderReceivedDate      DateTime?
  forwarderReceivedNotes     String?
  supplierDeclaredCbm        Decimal?
  forwarderMeasuredCbm       Decimal?
  agreedCbm                  Decimal?
  cbmDiscrepancyFlag         Boolean              @default(false)
  cbmConfirmedAt             DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  costs                      ImportCost[]
}

model ImportCost {
  id             String         @id @default(cuid())
  shipmentId     String
  costType       ImportCostType
  description    String?
  amountGhs      Decimal
  paymentMethod  PaymentMethod
  paymentDate    DateTime?
  receiptUrl     String?
  isPaid         Boolean        @default(false)
  cashApproved   Boolean        @default(false)
  cashApprovedAt DateTime?
  cashNotes      String?
  isLocked       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  shipment       ImportShipment @relation(fields: [shipmentId], references: [id])
}

model Product {
  id                 String              @id @default(cuid())
  sku                String              @unique
  name               String
  slug               String              @unique
  retailPrice        Float
  wholesalePrice     Float?
  distributorPrice   Float?
  stockQty           Int                 @default(0)
  lowStockThreshold  Int                 @default(3)
  categorySlug       String
  subCategorySlug    String?
  levelSlugs         String[]
  imageSrc           String
  imageAlt           String
  imageTitle         String?
  imageCaption       String?
  imageDescription   String?
  focusKeyphrase     String?
  metaTitle          String?
  metaDescription    String?
  socialTitle        String?
  socialDescription  String?
  shortSummary       String?
  fullDescription    String?
  brand              String?
  tags               String[]
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  author             String?
  costPrice          Float?
  stock              Int                 @default(0)
  publisher          String?
  supplier           Supplier?
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]

  returnItems ReturnItem[]
}

model InventoryMovement {
  id        String                @id @default(cuid())
  productId String
  type      InventoryMovementType
  quantity  Int
  note      String?
  createdAt DateTime              @default(now())
  orderId   String?
  order     Order?                @relation(fields: [orderId], references: [id])
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([orderId])
}

model Admin {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  pinHash   String
  role      AdminRole    @default(ADMIN)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  pin       String?
  events    OrderEvent[]
}

model OrderEvent {
  id          String         @id @default(cuid())
  orderId     String
  adminId     String
  eventType   OrderEventType
  description String
  createdAt   DateTime       @default(now())
  admin       Admin          @relation(fields: [adminId], references: [id])
  order       Order          @relation(fields: [orderId], references: [id])
}

model Staff {
  id            String         @id @default(cuid())
  staffNumber   String         @unique
  name          String
  role          StaffRole
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  branchId      String?
  bankDeposits  BankDeposit[]
  dailyClosings DailyClosing[]
  expenses      Expense[]
  purchases     Purchase[]
  branch        Branch?        @relation(fields: [branchId], references: [id])

  requestedReturns ReturnRequest[] @relation("ReturnRequestedBy")

approvedReturns ReturnRequest[] @relation("ReturnApprovedBy")
}

model Branch {
  id            String         @id @default(cuid())
  name          String
  location      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bankDeposits  BankDeposit[]
  dailyClosings DailyClosing[]
  expenses      Expense[]
  purchases     Purchase[]
  staff         Staff[]

  returnRequests ReturnRequest[]
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inventory {
  id           String       @id @default(cuid())
  productId    String
  locationType LocationType
  locationId   String
  quantity     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([productId, locationType, locationId])
}

model StockMovement {
  id               String        @id @default(cuid())
  productId        String
  type             MovementType
  quantity         Int
  fromLocationType LocationType?
  fromLocationId   String?
  toLocationType   LocationType?
  toLocationId     String?
  createdByStaffId String
  createdAt        DateTime      @default(now())
  status           String        @default("PENDING")
}

model DailyClosing {
  id              String        @id @default(cuid())
  branchId        String
  closedByStaffId String
  businessDate    DateTime
  openingFloat    Decimal       @db.Decimal(10, 2)
  expectedCash    Decimal       @db.Decimal(10, 2)
  actualCash      Decimal       @db.Decimal(10, 2)
  variance        Decimal       @db.Decimal(10, 2)
  varianceReason  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bankDeposits    BankDeposit[]
  branch          Branch        @relation(fields: [branchId], references: [id])
  closedByStaff   Staff         @relation(fields: [closedByStaffId], references: [id])
  expenses        Expense[]
  purchases       Purchase[]
}

model Expense {
  id               String        @id @default(cuid())
  dailyClosingId   String?
  branchId         String
  enteredByStaffId String
  expenseType      String
  amount           Decimal       @db.Decimal(10, 2)
  notes            String
  receiptImageUrl  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  branch           Branch        @relation(fields: [branchId], references: [id])
  dailyClosing     DailyClosing? @relation(fields: [dailyClosingId], references: [id])
  enteredByStaff   Staff         @relation(fields: [enteredByStaffId], references: [id])
}

model Purchase {
  id               String        @id @default(cuid())
  dailyClosingId   String?
  branchId         String
  enteredByStaffId String
  supplierName     String
  amount           Decimal       @db.Decimal(10, 2)
  referenceNumber  String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  branch           Branch        @relation(fields: [branchId], references: [id])
  dailyClosing     DailyClosing? @relation(fields: [dailyClosingId], references: [id])
  enteredByStaff   Staff         @relation(fields: [enteredByStaffId], references: [id])
}

model BankDeposit {
  id               String        @id @default(cuid())
  dailyClosingId   String?
  branchId         String
  enteredByStaffId String
  bankName         String
  amount           Decimal       @db.Decimal(10, 2)
  referenceNumber  String?
  depositMethod    String
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  branch           Branch        @relation(fields: [branchId], references: [id])
  dailyClosing     DailyClosing? @relation(fields: [dailyClosingId], references: [id])
  enteredByStaff   Staff         @relation(fields: [enteredByStaffId], references: [id])
}

model ReturnRequest {
  id String @id @default(cuid())

  returnNumber String @unique

  orderId String
  order Order @relation(fields: [orderId], references: [id])

  branchId String
  branch Branch @relation(fields: [branchId], references: [id])

  requestedByStaffId String
  requestedByStaff Staff @relation("ReturnRequestedBy", fields: [requestedByStaffId], references: [id])

  approvedByStaffId String?
  approvedByStaff Staff? @relation("ReturnApprovedBy", fields: [approvedByStaffId], references: [id])

  type ReturnType

  status ReturnStatus @default(PENDING)

  customerReason String

  managerDecisionReason String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  completedAt DateTime?

  items ReturnItem[]
}

model ReturnItem {
  id String @id @default(cuid())

  returnRequestId String
  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id])

  orderItemId String
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  productId String
  product Product @relation(fields: [productId], references: [id])

  quantity Int

  condition ReturnCondition

  itemReason String?

  createdAt DateTime @default(now())
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  DELIVERING
  COMPLETED
  CANCELLED
}

enum ImportShipmentStatus {
  DRAFT
  PAID
  IN_TRANSIT
  ARRIVED_GH
  COMPLETED
}

enum ImportSourceApp {
  ALIBABA
  APP_1688
  TAOBAO
  WECHAT
  OTHER
}

enum ShippingMode {
  AIR
  SEA
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOMO
  ONLINE_CARD
  OTHER
}

enum ImportCostType {
  SUPPLIER
  INTERNATIONAL_SHIPPING
  CLEARING_FEES
  FREIGHT_FORWARDER_FEES
  LOCAL_TRANSPORT
  OTHER
}

enum InventoryMovementType {
  SALE
  ADMIN_ADJUSTMENT
  RESTOCK
  IMPORT_ALLOCATION
  RETURN
  DAMAGE
  TRANSFER_OUT
  TRANSFER_IN
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum OrderEventType {
  VIEWED
  NOTE_ADDED
  DELIVERY_FEE_UPDATED
  STATUS_CHANGED
  PAYMENT_CONFIRMED
}

enum StaffRole {
  SUPER_ADMIN
  MANAGER
  CASHIER
  SALES
  DELIVERY_RIDER
  WAREHOUSE_MANAGER
  CRM_AGENT
}

enum LocationType {
  WAREHOUSE
  BRANCH
}

enum MovementType {
  PURCHASE
  TRANSFER
  SALE
  ADJUSTMENT
  RETURN
}

enum Supplier {
  AKI_OLA
  A_PLUS
  GOLDEN
  BEST_BRAIN
  EXCELLENCE
  ESSENTIAL
  AUNTIE_DIANA
  DWT
  WUCHARD
  TSINA
  MAKOLA
  WISE_ANT
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  INSPECTED
  REFUNDED
  EXCHANGED
  COMPLETED
}

enum ReturnType {
  REFUND
  EXCHANGE
}

enum ReturnCondition {
  GOOD
  DAMAGED
  DEFECTIVE
  OPENED
}