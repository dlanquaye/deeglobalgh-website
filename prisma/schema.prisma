generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DATABASE_URL_UNPOOLED")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Order {
  id                 String              @id @default(cuid())
  orderId            String              @unique
  reference          String?             @unique
  email              String
  phone              String
  amount             Int
  paymentStatus      PaymentStatus       @default(PENDING)
  smsSent            Boolean             @default(false)
  createdAt          DateTime            @default(now())
  adminNotes         String?
  deliveryFee        Int?
  completedSmsSent   Boolean             @default(false)
  deliverySmsSent    Boolean             @default(false)
  stockReduced       Boolean             @default(false)
  status             String              @default("PENDING")
  locationId         String?
  customerName       String?
  paymentMethod      String?
  inventoryMovements InventoryMovement[]
  events             OrderEvent[]
  orderItems         OrderItem[]
  returns            ReturnRequest[]

  @@index([orderId])
  @@index([reference])
}

model OrderItem {
  id          String       @id @default(cuid())
  orderId     String
  productId   String
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime     @default(now())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [productId], references: [id])
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([productId])
}

model ImportShipment {
  id                         String               @id @default(cuid())
  reference                  String
  supplierName               String
  sourceApp                  ImportSourceApp
  sourceAppOther             String?
  freightForwarderName       String
  shippingMode               ShippingMode
  supplierTrackingId         String?
  supplierTrackingNotes      String?
  paymentFinalizedDate       DateTime?
  currency                   String
  exchangeRateSnapshot       Decimal
  status                     ImportShipmentStatus @default(DRAFT)
  forwarderReceivedConfirmed Boolean              @default(false)
  forwarderReceivedDate      DateTime?
  forwarderReceivedNotes     String?
  supplierDeclaredCbm        Decimal?
  forwarderMeasuredCbm       Decimal?
  agreedCbm                  Decimal?
  cbmDiscrepancyFlag         Boolean              @default(false)
  cbmConfirmedAt             DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  costs                      ImportCost[]
}

model ImportCost {
  id             String         @id @default(cuid())
  shipmentId     String
  costType       ImportCostType
  description    String?
  amountGhs      Decimal
  paymentMethod  PaymentMethod
  paymentDate    DateTime?
  receiptUrl     String?
  isPaid         Boolean        @default(false)
  cashApproved   Boolean        @default(false)
  cashApprovedAt DateTime?
  cashNotes      String?
  isLocked       Boolean        @default(false)
  createdAt      DateTime       @default(now())
  shipment       ImportShipment @relation(fields: [shipmentId], references: [id])
}

model Product {
  id                 String              @id @default(cuid())
  sku                String              @unique
  name               String
  slug               String              @unique
  retailPrice        Float
  wholesalePrice     Float?
  distributorPrice   Float?
  stockQty           Int                 @default(0)
  lowStockThreshold  Int                 @default(3)
  categorySlug       String
  subCategorySlug    String?
  levelSlugs         String[]
  imageSrc           String
  imageAlt           String
  imageTitle         String?
  imageCaption       String?
  imageDescription   String?
  focusKeyphrase     String?
  metaTitle          String?
  metaDescription    String?
  socialTitle        String?
  socialDescription  String?
  shortSummary       String?
  fullDescription    String?
  brand              String?
  tags               String[]
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  author             String?
  bookId             String?
  costPrice          Float?
  stock              Int                 @default(0)
  publisher          String?
  supplier           Supplier?
  inventoryMovements InventoryMovement[]
  orderItems         OrderItem[]
  returnItems        ReturnItem[]

  fingerprint ProductFingerprint?

  estimateItems EstimateItem[]

  knowledgeNodeId String?
  knowledgeNode   KnowledgeNode? @relation(fields: [knowledgeNodeId], references: [id])

  book Book? @relation(fields: [bookId], references: [id], onDelete: SetNull)
}

model ProductFingerprint {
  id String @id @default(cuid())

  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  subjectNodeCode    String?
  publisherNodeCode  String?
  curriculumNodeCode String?
  resourceNodeCode   String?
  activityNodeCode   String?
  languageNodeCode   String?

  confidence Int

  engineVersion Int @default(2)

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([subjectNodeCode])
  @@index([publisherNodeCode])
  @@index([curriculumNodeCode])
  @@index([resourceNodeCode])
  @@index([activityNodeCode])
  @@index([languageNodeCode])
}

model InventoryMovement {
  id        String                @id @default(cuid())
  productId String
  type      InventoryMovementType
  quantity  Int
  note      String?
  createdAt DateTime              @default(now())
  orderId   String?
  order     Order?                @relation(fields: [orderId], references: [id])
  product   Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([orderId])
}

model Admin {
  id        String       @id @default(cuid())
  name      String
  email     String       @unique
  pinHash   String
  role      AdminRole    @default(ADMIN)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  pin       String?
  staffId   String?      @unique
  staff     Staff?       @relation(fields: [staffId], references: [id])
  events    OrderEvent[]
}

model OrderEvent {
  id          String         @id @default(cuid())
  orderId     String
  adminId     String
  eventType   OrderEventType
  description String
  createdAt   DateTime       @default(now())
  admin       Admin          @relation(fields: [adminId], references: [id])
  order       Order          @relation(fields: [orderId], references: [id])
}

model Staff {
  id               String          @id @default(cuid())
  staffNumber      String          @unique
  name             String
  role             StaffRole
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  branchId         String?
  adminAccount     Admin?
  bankDeposits     BankDeposit[]
  dailyClosings    DailyClosing[]
  expenses         Expense[]
  purchases        Purchase[]
  approvedReturns  ReturnRequest[] @relation("ReturnApprovedBy")
  requestedReturns ReturnRequest[] @relation("ReturnRequestedBy")
  branch           Branch?         @relation(fields: [branchId], references: [id])
}

model Branch {
  id             String          @id @default(cuid())
  name           String
  location       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bankDeposits   BankDeposit[]
  dailyClosings  DailyClosing[]
  expenses       Expense[]
  purchases      Purchase[]
  returnRequests ReturnRequest[]
  staff          Staff[]
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Inventory {
  id           String       @id @default(cuid())
  productId    String
  locationType LocationType
  locationId   String
  quantity     Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([productId, locationType, locationId])
}

model StockMovement {
  id               String        @id @default(cuid())
  productId        String
  type             MovementType
  quantity         Int
  fromLocationType LocationType?
  fromLocationId   String?
  toLocationType   LocationType?
  toLocationId     String?
  createdByStaffId String
  createdAt        DateTime      @default(now())
  status           String        @default("PENDING")
}

model DailyClosing {
  id              String        @id @default(cuid())
  branchId        String
  closedByStaffId String
  businessDate    DateTime
  openingFloat    Decimal       @db.Decimal(10, 2)
  expectedCash    Decimal       @db.Decimal(10, 2)
  actualCash      Decimal       @db.Decimal(10, 2)
  variance        Decimal       @db.Decimal(10, 2)
  varianceReason  String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  bankDeposits    BankDeposit[]
  branch          Branch        @relation(fields: [branchId], references: [id])
  closedByStaff   Staff         @relation(fields: [closedByStaffId], references: [id])
  expenses        Expense[]
  purchases       Purchase[]
}

model Expense {
  id               String        @id @default(cuid())
  dailyClosingId   String?
  branchId         String
  enteredByStaffId String
  expenseType      String
  amount           Decimal       @db.Decimal(10, 2)
  notes            String
  receiptImageUrl  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  branch           Branch        @relation(fields: [branchId], references: [id])
  dailyClosing     DailyClosing? @relation(fields: [dailyClosingId], references: [id])
  enteredByStaff   Staff         @relation(fields: [enteredByStaffId], references: [id])
}

model Purchase {
  id               String        @id @default(cuid())
  dailyClosingId   String?
  branchId         String
  enteredByStaffId String
  supplierName     String
  amount           Decimal       @db.Decimal(10, 2)
  referenceNumber  String?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  branch           Branch        @relation(fields: [branchId], references: [id])
  dailyClosing     DailyClosing? @relation(fields: [dailyClosingId], references: [id])
  enteredByStaff   Staff         @relation(fields: [enteredByStaffId], references: [id])
}

model BankDeposit {
  id               String        @id @default(cuid())
  dailyClosingId   String?
  branchId         String
  enteredByStaffId String
  bankName         String
  amount           Decimal       @db.Decimal(10, 2)
  referenceNumber  String?
  depositMethod    String
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  branch           Branch        @relation(fields: [branchId], references: [id])
  dailyClosing     DailyClosing? @relation(fields: [dailyClosingId], references: [id])
  enteredByStaff   Staff         @relation(fields: [enteredByStaffId], references: [id])
}

model ReturnRequest {
  id                    String       @id @default(cuid())
  returnNumber          String       @unique
  orderId               String
  branchId              String
  requestedByStaffId    String
  approvedByStaffId     String?
  type                  ReturnType
  status                ReturnStatus @default(PENDING)
  customerReason        String
  managerDecisionReason String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  completedAt           DateTime?
  items                 ReturnItem[]
  approvedByStaff       Staff?       @relation("ReturnApprovedBy", fields: [approvedByStaffId], references: [id])
  branch                Branch       @relation(fields: [branchId], references: [id])
  order                 Order        @relation(fields: [orderId], references: [id])
  requestedByStaff      Staff        @relation("ReturnRequestedBy", fields: [requestedByStaffId], references: [id])
}

model ReturnItem {
  id              String          @id @default(cuid())
  returnRequestId String
  orderItemId     String
  productId       String
  quantity        Int
  condition       ReturnCondition
  itemReason      String?
  createdAt       DateTime        @default(now())
  orderItem       OrderItem       @relation(fields: [orderItemId], references: [id])
  product         Product         @relation(fields: [productId], references: [id])
  returnRequest   ReturnRequest   @relation(fields: [returnRequestId], references: [id])
}

model EstimateRequest {
  id String @id @default(cuid())

  estimateNumber String @unique

  status EstimateStatus @default(NEW)

  source EstimateSource @default(WEBSITE)

  customerName String

  phone String

  email String?

  schoolName String?

  className String?

  academicYear String?

  notes String?

  estimatedTotal Decimal? @db.Decimal(10, 2)

  attachments EstimateAttachment[]

  items EstimateItem[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  isArchived Boolean @default(false)

  priority EstimatePriority @default(NORMAL)

  @@index([status])
  @@index([source])
  @@index([customerName])
  @@index([phone])
  @@index([createdAt])
}

model EstimateAttachment {
  id String @id @default(cuid())

  estimateRequestId String

  estimateRequest EstimateRequest @relation(fields: [estimateRequestId], references: [id], onDelete: Cascade)

  fileName String

  filePath String

  fileType EstimateAttachmentType

  fileSize Int?

  ocrText String?

  ocrStatus OcrStatus @default(PENDING)

  booksFound Int?

  matchedBooks Int?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([estimateRequestId])
}

model EstimateItem {
  id String @id @default(cuid())

  estimateRequestId String

  estimateRequest EstimateRequest @relation(fields: [estimateRequestId], references: [id], onDelete: Cascade)

  lineNumber Int

  quantity Int @default(1)

  description String

  productId String?

  product Product? @relation(fields: [productId], references: [id])

  matchMethod MatchMethod @default(NONE)

  matchConfidence Float?

  unitPrice Decimal? @db.Decimal(10, 2)

  totalPrice Decimal? @db.Decimal(10, 2)

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  matchStatus MatchStatus @default(PENDING)

  @@index([estimateRequestId])
  @@index([productId])
}

model DocumentSequence {
  id String @id @default(cuid())

  document String

  year Int

  month Int

  lastNumber Int @default(0)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@unique([document, year, month])
  @@index([document])
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

model KnowledgeNode {
  id          String  @id @default(cuid())
  code        String  @unique
  slug        String  @unique
  name        String
  description String?

  nodeType KnowledgeNodeType
  status   KnowledgeStatus   @default(ACTIVE)

  parentId String?
  parent   KnowledgeNode?  @relation("KnowledgeNodeHierarchy", fields: [parentId], references: [id])
  children KnowledgeNode[] @relation("KnowledgeNodeHierarchy")

  outgoingRelationships KnowledgeRelationship[] @relation("KnowledgeNodeSource")
  incomingRelationships KnowledgeRelationship[] @relation("KnowledgeNodeTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([nodeType])
  @@index([slug])
}

model KnowledgeRelationship {
  id String @id @default(cuid())

  sourceId String
  targetId String

  relationshipType KnowledgeRelationType

  weight Float @default(1)

  source KnowledgeNode @relation("KnowledgeNodeSource", fields: [sourceId], references: [id])
  target KnowledgeNode @relation("KnowledgeNodeTarget", fields: [targetId], references: [id])

  createdAt DateTime @default(now())

  @@unique([sourceId, targetId, relationshipType])
  @@index([sourceId])
  @@index([targetId])
}

model Publisher {
  id      String  @id @default(cuid())
  code    String  @unique
  name    String  @unique
  website String?

  aliases   PublisherAlias[]
  bookLines BookLine[]
  books     Book[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PublisherAlias {
  id String @id @default(cuid())

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  alias String

  @@unique([publisherId, alias])
}

model Subject {
  id   String @id @default(cuid())
  code String @unique
  name String @unique

  books Book[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases SubjectAlias[]
}

model Level {
  id        String @id @default(cuid())
  code      String @unique
  name      String @unique
  sortOrder Int

  books Book[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases LevelAlias[]
}

model ResourceTypeAlias {
  id String @id @default(cuid())

  resourceTypeId String
  resourceType   ResourceType @relation(fields: [resourceTypeId], references: [id], onDelete: Cascade)

  alias String

  @@unique([resourceTypeId, alias])
}

model ResourceType {
  id   String @id @default(cuid())
  code String @unique
  name String @unique

  books Book[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases ResourceTypeAlias[]
}

model LanguageAlias {
  id String @id @default(cuid())

  languageId String
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  alias String

  @@unique([languageId, alias])
}

model Language {
  id   String @id @default(cuid())
  code String @unique
  name String @unique

  books Book[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases LanguageAlias[]
}

model CurriculumAlias {
  id String @id @default(cuid())

  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)

  alias String

  @@unique([curriculumId, alias])
}

model Curriculum {
  id   String @id @default(cuid())
  code String @unique
  name String @unique

  books Book[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases CurriculumAlias[]
}

model OfficialSource {
  id String @id @default(cuid())

  organisation String
  name         String
  version      String?

  sourceType OfficialSourceType

  sourceUrl String?

  documentHash String?

  publishedDate DateTime?

  importedAt DateTime @default(now())

  status OfficialSourceStatus @default(ACTIVE)

  notes String?

  books Book[]

  syncSessions SyncSession[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organisation])
  @@index([status])
}

model SyncSession {
  id String @id @default(cuid())

  officialSourceId String

  officialSource OfficialSource @relation(fields: [officialSourceId], references: [id])

  startedAt DateTime @default(now())

  finishedAt DateTime?

  status SyncStatus @default(RUNNING)

  publishersAdded   Int @default(0)
  publishersUpdated Int @default(0)

  bookLinesAdded   Int @default(0)
  bookLinesUpdated Int @default(0)

  booksAdded   Int @default(0)
  booksUpdated Int @default(0)

  authorsAdded   Int @default(0)
  authorsUpdated Int @default(0)

  aliasesAdded Int @default(0)

  warnings Int @default(0)

  errors Int @default(0)

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startedAt])
}

model BookLine {
  id String @id @default(cuid())

  code String @unique
  name String

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id])

  books Book[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([publisherId, name])
}

model Author {
  id String @id @default(cuid())

  fullName String @unique

  books BookAuthor[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookAuthor {
  id String @id @default(cuid())

  bookId   String
  authorId String

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([bookId, authorId])
}

model Book {
  id String @id @default(cuid())

  title String

  isbn String?

  officialSourceId String

  officialSource OfficialSource @relation(fields: [officialSourceId], references: [id])

  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id])

  bookLineId String
  bookLine   BookLine @relation(fields: [bookLineId], references: [id])

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  levelId String
  level   Level  @relation(fields: [levelId], references: [id])

  resourceTypeId String
  resourceType   ResourceType @relation(fields: [resourceTypeId], references: [id])

  languageId String
  language   Language @relation(fields: [languageId], references: [id])

  curriculumId String
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id])

  authors BookAuthor[]

  products Product[]

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubjectAlias {
  id String @id @default(cuid())

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  alias String

  @@unique([subjectId, alias])
}

model LevelAlias {
  id String @id @default(cuid())

  levelId String
  level   Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)

  alias String

  @@unique([levelId, alias])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  DELIVERING
  COMPLETED
  CANCELLED
}

enum ImportShipmentStatus {
  DRAFT
  PAID
  IN_TRANSIT
  ARRIVED_GH
  COMPLETED
}

enum ImportSourceApp {
  ALIBABA
  APP_1688
  TAOBAO
  WECHAT
  OTHER
}

enum ShippingMode {
  AIR
  SEA
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOMO
  ONLINE_CARD
  OTHER
}

enum ImportCostType {
  SUPPLIER
  INTERNATIONAL_SHIPPING
  CLEARING_FEES
  FREIGHT_FORWARDER_FEES
  LOCAL_TRANSPORT
  OTHER
}

enum InventoryMovementType {
  SALE
  ADMIN_ADJUSTMENT
  RESTOCK
  IMPORT_ALLOCATION
  RETURN
  DAMAGE
  TRANSFER_OUT
  TRANSFER_IN
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum OrderEventType {
  VIEWED
  NOTE_ADDED
  DELIVERY_FEE_UPDATED
  STATUS_CHANGED
  PAYMENT_CONFIRMED
}

enum StaffRole {
  SUPER_ADMIN
  MANAGER
  CASHIER
  SALES
  DELIVERY_RIDER
  WAREHOUSE_MANAGER
  CRM_AGENT
}

enum LocationType {
  WAREHOUSE
  BRANCH
}

enum MovementType {
  PURCHASE
  TRANSFER
  SALE
  ADJUSTMENT
  RETURN
}

enum Supplier {
  AKI_OLA
  A_PLUS
  GOLDEN
  BEST_BRAIN
  EXCELLENCE
  ESSENTIAL
  AUNTIE_DIANA
  DWT
  WUCHARD
  TSINA
  MAKOLA
  WISE_ANT
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  INSPECTED
  REFUNDED
  EXCHANGED
  COMPLETED
}

enum ReturnType {
  REFUND
  EXCHANGE
}

enum ReturnCondition {
  GOOD
  DAMAGED
  DEFECTIVE
  OPENED
}

enum EstimateStatus {
  NEW
  PROCESSING
  MATCHING
  REVIEW_REQUIRED
  QUOTED
  APPROVED
  CART_CREATED
  ORDER_CREATED
  COMPLETED
  CANCELLED
}

enum EstimateSource {
  WEBSITE
  WHATSAPP
  WALK_IN
  ADMIN
}

enum EstimateAttachmentType {
  IMAGE
  PDF
  WORD
  EXCEL
  TEXT
}

enum MatchMethod {
  NONE
  AUTO
  MANUAL
}

enum EstimatePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MatchStatus {
  PENDING
  MATCHED
  NOT_FOUND
}

enum KnowledgeStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum KnowledgeRelationType {
  RELATED_TO
  RECOMMENDS
  SUPPORTS
  REQUIRES
  PREREQUISITE_FOR
  CONTRIBUTES_TO
  ENHANCES
  COMPLEMENTS
  ALTERNATIVE_TO
}

enum VocabularyType {
  CUSTOMER
  SEARCH
  COMMON_NAME
  SLANG
}

enum AliasType {
  SPELLING
  ALTERNATIVE
  ABBREVIATION
}

enum KnowledgeNodeType {
  PRODUCT_FAMILY
  CATEGORY
  SUBJECT
  EDUCATIONAL_CAPABILITY
  DEVELOPMENTAL_CAPABILITY
  COGNITIVE_CAPABILITY
  EDUCATIONAL_OUTCOME
  LIFE_SKILL
  CHARACTER_TRAIT
}

enum OcrStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum OfficialSourceType {
  PDF
  WEBSITE
  API
  EXCEL
  CSV
  MANUAL
}

enum OfficialSourceStatus {
  ACTIVE
  SUPERSEDED
  ARCHIVED
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}
